NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@127.0.0.1:3306/flowfreeze
# Shopify values are injected by Webdev when the integration is configured.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
FLOWFREEZE_LOCAL=true

# Optional separate FastAPI model service
PYTHON_API_URL=http://127.0.0.1:8000
FLOWFREEZE_ENABLE_LLM=false
FLOWFREEZE_LLM_MODEL=gpt-5-mini
