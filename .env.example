NODE_ENV=development
PORT=3000
FLOWFREEZE_LOCAL=true
PYTHON_API_URL=http://127.0.0.1:8000

# --- API authentication (REQUIRED: protected endpoints return 401 without a token) ---
# format: token:role,token:role   roles: viewer | analyst | admin
FLOWFREEZE_API_TOKENS=change-me-long-random:analyst
# token the Node BFF uses when calling the Python service
FLOWFREEZE_API_TOKEN=change-me-long-random
# local demo only: enables built-in demo-analyst-token / demo-viewer-token. NEVER enable in a shared deployment.
FLOWFREEZE_DEMO_MODE=false

FLOWFREEZE_ENABLE_LLM=false
FLOWFREEZE_LLM_MODEL=gpt-5-mini
